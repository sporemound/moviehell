{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "movie-hell",
  "main": "worker.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": ["/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aggregation-hub-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOMS",
        "class_name": "ChatRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"]
    }
  ],
  "vars": {
    "ADMIN_USER_IDS": "",
    "MODERATOR_USER_IDS": "",
    "APPROVAL_THRESHOLD": "2"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
